{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|alerts/|sw\\.js|.*\\.(?:png|svg|webmanifest|map)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
